    <string name="phone_speed_source_car_hint" translatable="false">Only the car\'s own speed; never the phone\'s location.</string>
    <string name="phone_speed_source_off_hint" translatable="false">No speed is shown.</string>
    <string name="phone_nav_text_title" translatable="false">Log the maps app\'s texts</string>
    <string name="phone_nav_text_hint" translatable="false">For the Waze check: every text the maps app sends to the car screen goes into the connection log, marked when it looks like a speed. The log on the phone then holds street names and your destination; a shared Car check log keeps only the speeds. Off when done.</string>
    <string name="phone_orbit_preview_title" translatable="false">MyPlay car screen (ORBIT)</string>
    <string name="phone_orbit_preview_hint" translatable="false">The car screen MyPlay draws itself: the home and every world (navigate, music, calls, apps, car, settings). On by default. Off: the car uses an older layout chosen below (taskbar, dock, classic, map behind); those will be removed later. The picture above shows it.</string>
    <string name="phone_speed_warning" translatable="false">Over the limit</string>
    <string name="phone_speed_warning_hint" translatable="false">The car screen\'s speed turns amber when you are this far over the known limit.</string>
    <string name="phone_speed_limit_needs_location" translatable="false">The limit is found from the phone\'s location, so it is not shown with the speed set to Car only.</string>
