    <string name="phone_size_large" translatable="false">Large</string>
    <string name="phone_size_larger" translatable="false">Larger</string>
    <string name="phone_status_colour" translatable="false">Colour</string>
    <string name="phone_status_colour_hint" translatable="false">Default follows the look by day and by night. A fixed colour stays the same, so white can be hard to see with light day colours.</string>
    <string name="phone_colour_n" translatable="false">Colour %1$d</string>
    <string name="phone_status_by_level" translatable="false">Colour by level</string>
    <string name="phone_status_low" translatable="false">Low, up to %1$d %%</string>
    <string name="phone_status_middle" translatable="false">Middle, up to %1$d %%</string>
    <string name="phone_status_high" translatable="false">High</string>
    <string name="phone_status_by_level_on" translatable="false">The battery takes the colour of its band. While charging it keeps the colour above.</string>
    <string name="phone_status_by_level_off" translatable="false">Off: the battery is red when low and otherwise takes the colour above.</string>
    <string name="phone_clock_size_hint" translatable="false">In a bar at the side (and in the Dock), the clock is limited by the bar\'s width, so Large and Larger may look like Normal there. They show fully in a bottom bar or in the Clock and status card.</string>
    <string name="phone_clock_style" translatable="false">Style</string>
    <string name="phone_clock_bold" translatable="false">Bold</string>
    <string name="phone_clock_bold_sub" translatable="false">Thicker digits. The Retro look keeps its own digits.</string>
    <string name="phone_backup_save" translatable="false">Save settings to a file</string>
    <string name="phone_backup_save_sub" translatable="false">Choose where; keep it somewhere safe</string>
    <string name="phone_backup_save_button" translatable="false">Save</string>
    <string name="phone_backup_load" translatable="false">Load settings from a file</string>
    <string name="phone_backup_load_sub" translatable="false">Replaces the settings in the file; asks first</string>
    <string name="phone_backup_load_button" translatable="false">Load</string>
    <string name="phone_backup_restores_all" translatable="false">Loading restores every setting in the file, including ones that use the internet: the update check, the weather and the browser\'s address. If they were on when the file was saved, they are on again.</string>
    <string name="phone_backup_no_photo" translatable="false">A wallpaper photo is not in the file. After loading, choose the photo again on the Wallpaper page.</string>
    <string name="phone_backup_saved" translatable="false">Settings saved.</string>
