    <string name="phone_buttons_hold_time" translatable="false">A hold is a press longer than %1$d ms</string>
    <string name="phone_buttons_double_time" translatable="false">A double press is two presses within %1$d ms</string>
    <string name="phone_buttons_codes_unknown" translatable="false">Which signals the box sends for each button is not known until a connection log from the car. If the wheel and the knob send the same signal, they share one set of gestures.</string>
