    <string name="phone_tile_car_check" translatable="false">Car check</string>
    <string name="phone_check_not_connected" translatable="false">No car is connected. Connect first: the check listens to what the car sends.</string>
    <string name="phone_check_how" translatable="false">Parked, with the car connected: do what each step says. Whatever the car sends while a step is on screen is recorded for that step. The car screen also reacts, which is fine.</string>
