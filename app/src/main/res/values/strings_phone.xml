    <string name="phone_teach_forget" translatable="false">Forget %1$s</string>
    <string name="phone_teach_seconds" translatable="false">Waiting %1$d more seconds.</string>
    <string name="phone_info_home_hint" translatable="false">The home never shows the knob\'s ring: the pad and the taught buttons do everything. Needs a pad key set to The dial or Apps, so the car\'s settings stay reachable; without one the ring stays.</string>
    <string name="phone_youtube_app_title" translatable="false">YouTube app on the car screen</string>
    <string name="phone_youtube_app_action" translatable="false">Put it on</string>
    <string name="phone_youtube_app_hint" translatable="false">The real YouTube app, as a phone app on the car screen: parked only, with root or Shizuku. Turning it on also turns on phone apps on the car screen. While it is on, the car leaves out the YouTube website entry, so there is only one YouTube.</string>
    <string name="phone_youtube_app_needs_root" translatable="false">The real YouTube app, as a phone app on the car screen: parked only. Needs root or Shizuku, which this phone does not give MyPlay yet.</string>
    <string name="phone_youtube_app_also" translatable="false">This also turns on phone apps on the car screen, with any other apps chosen below.</string>
    <string name="phone_speed_mobile_title" translatable="false">Download on mobile data</string>
    <string name="phone_speed_mobile_hint" translatable="false">Off: Wi-Fi only. On: the file and its monthly update may also use mobile data, never when roaming.</string>
    <string name="phone_speed_mobile_confirm" translatable="false">The speed limit file is %1$s. Downloading it, and each monthly update, may then use that much mobile data.</string>
    <string name="phone_speed_mobile_confirm_unknown" translatable="false">The file\'s size could not be looked up just now. Downloading it, and each monthly update, may then use mobile data.</string>
