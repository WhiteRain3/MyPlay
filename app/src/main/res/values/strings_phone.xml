    <string name="phone_parts_help" translatable="false">Help</string>

    <!-- The start screen (Customise). -->
    <string name="phone_customise_title" translatable="false">Customise</string>
    <string name="phone_customise_hint" translatable="false">Tap a part of the picture to change it</string>
    <string name="phone_customise_picture_description" translatable="false">Picture of the car screen. Tap to change how it looks.</string>
    <string name="phone_part_picture_description" translatable="false">Picture of the car screen with the current settings</string>
    <string name="phone_part_bar" translatable="false">Bar</string>
    <string name="phone_bar_side" translatable="false">Side</string>
    <string name="phone_bar_items" translatable="false">Shown on the bar, in this order</string>
    <string name="phone_bar_items_hint" translatable="false">A bar at the side of a short screen (the Audi\'s) has room for the clock only; the others show when the bar is at the bottom.</string>
    <string name="phone_bar_more" translatable="false">Colour and weather</string>
    <string name="phone_part_cards" translatable="false">Cards</string>
    <string name="phone_cards_weather_note" translatable="false">While this card is on, MyPlay sends a rough position (about 10 km) to Open-Meteo, even with the Weather switch off</string>
    <string name="phone_home_maps_question" translatable="false">Which map the home screen shows</string>
    <string name="phone_slots_hint" translatable="false">Drag a card to a place, or down here to hide it. The first place is the most important. The rows below do the same with arrows.</string>
    <string name="phone_slots_tray_empty" translatable="false">Not shown: none. Drag a card here to hide it.</string>
    <string name="phone_home_maps_unavailable" translatable="false">This maps app is hidden or no longer installed, so the home screen shows the maps buttons instead.</string>
    <string name="phone_cards_order" translatable="false">Shown, in this order</string>
