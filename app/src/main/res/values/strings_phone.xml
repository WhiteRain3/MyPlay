    <string name="phone_layout_kind_hint" translatable="false">How the home screen is laid out</string>
    <string name="phone_layout_at_once" translatable="false">Changes here show on a connected car at once.</string>
    <string name="phone_layout_presets" translatable="false">Ready-made layouts</string>
    <string name="phone_layout_preset_name" translatable="false">Layout %1$s</string>
    <string name="phone_layout_preset_hint" translatable="false">Tap one to use it. Each option below can then be changed on its own.</string>
    <string name="phone_layout_own" translatable="false">Your own mix: options were changed after choosing a ready-made layout.</string>
    <string name="phone_layout_map" translatable="false">Map</string>
    <string name="phone_layout_map_background" translatable="false">Map behind everything</string>
    <string name="phone_layout_map_background_sub" translatable="false">The maps app fills the screen. Off: a plain dark background</string>
    <string name="phone_layout_map_under" translatable="false">Map under the bar too</string>
    <string name="phone_layout_map_under_sub" translatable="false">Off: the map stops at the bar\'s edge</string>
    <string name="phone_layout_map_under_needs" translatable="false">Needs \"Map behind everything\"</string>
