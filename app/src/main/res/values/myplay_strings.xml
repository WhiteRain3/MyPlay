<resources>
    <string name="myplay_about_fork" translatable="false">MyPlay is a personal fork of AARE by prototux and contributors. It is free software under the same licence, GPL-3.0-or-later. MyPlay is not AARE and is not Android Auto.</string>
    <string name="myplay_about_link_upstream" translatable="false">AARE (original project)</string>
    <string name="myplay_update_check_now" translatable="false">Check now</string>
    <string name="myplay_update_check_now_hint" translatable="false">Asks GitHub once for the latest MyPlay release. Nothing about you or this phone is sent; GitHub sees your internet address, as any website does.</string>
