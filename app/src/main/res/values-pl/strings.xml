<resources>
    <string name="app_name">MyPlay</string>
    <string name="mirror_touch_description">Pozwala korzystać z ekranu telefonu z samochodu: MyPlay powtarza na telefonie dotknięcia wykonane na ekranie samochodu i sprawdza, która aplikacja jest aktywna, dzięki czemu ekran telefonu pozostaje wstrzymany podczas jazdy, jeśli nie wyświetla aplikacji nawigacyjnej. MyPlay nie odczytuje niczego innego.</string>
    <string name="mirror_locked_placeholder">Ekran telefonu jest wstrzymany, gdy telefon jest zablokowany. Odblokuj telefon, aby go wyświetlić.</string>
    <string name="mirror_driving_no_accessibility">Ekran telefonu jest wstrzymany podczas jazdy. Aby wyświetlać aplikacje nawigacyjne podczas jazdy, włącz MyPlay w ustawieniach ułatwień dostępu telefonu: to pozwala MyPlay wiedzieć, która aplikacja jest otwarta.</string>
    <string name="mirror_driving_nav_only">Ekran telefonu jest wstrzymany podczas jazdy. Wyświetla tylko aplikacje nawigacyjne.</string>
    <string name="mirror_need_screen_capture">Ekran telefonu wymaga uprawnienia Androida do przechwytywania ekranu. Na telefonie otwórz ustawienia Dźwięk w samochodzie aplikacji MyPlay, dotknij Uprawnienie do przechwytywania ekranu i wybierz Cały ekran.</string>
    <string name="mirror_capture_failed">Android odmówił udostępnienia ekranu telefonu. Na telefonie dotknij ponownie Uprawnienie do przechwytywania ekranu w ustawieniach Dźwięk w samochodzie aplikacji MyPlay i wybierz Cały ekran.</string>
    <string name="mirror_need_accessibility">Aby korzystać z telefonu z samochodu, włącz MyPlay w ustawieniach ułatwień dostępu telefonu.</string>

