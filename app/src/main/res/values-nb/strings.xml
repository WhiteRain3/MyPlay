<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">MyPlay</string>
    <string name="mirror_touch_description">Lar deg bruke telefonskjermen fra bilen: MyPlay gjengir berøringene som gjøres på bilskjermen, på telefonen, og kontrollerer hvilken app som er i forgrunnen, slik at telefonskjermen forblir pauset under kjøring med mindre den viser en navigasjonsapp. MyPlay leser ingenting annet.</string>
    <string name="mirror_locked_placeholder">Telefonskjermen er pauset mens telefonen er låst. Lås opp telefonen for å vise den.</string>
    <string name="mirror_driving_no_accessibility">Telefonskjermen er pauset under kjøring. For å vise navigasjonsapper under kjøring, slå på MyPlay i telefonens tilgjengelighetsinnstillinger: det forteller MyPlay hvilken app som er åpen.</string>
    <string name="mirror_driving_nav_only">Telefonskjermen er pauset under kjøring. Den viser bare navigasjonsapper.</string>
    <string name="mirror_need_screen_capture">Telefonskjermen trenger Androids tillatelse for skjermopptak. Åpne MyPlays innstillinger for Bilaudio på telefonen, trykk på Tillatelse for skjermopptak og velg Hele skjermen.</string>
    <string name="mirror_capture_failed">Android avslo å dele telefonskjermen. Trykk på nytt på Tillatelse for skjermopptak i MyPlays innstillinger for Bilaudio på telefonen og velg Hele skjermen.</string>
    <string name="mirror_need_accessibility">For å bruke telefonen fra bilen, slå på MyPlay i telefonens tilgjengelighetsinnstillinger.</string>

