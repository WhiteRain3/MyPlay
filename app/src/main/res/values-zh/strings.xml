    <string name="app_name">MyPlay</string>
    <string name="mirror_touch_description">让你在车机上操作手机屏幕：MyPlay 会将车机屏幕上的点击重放到手机上，并检测当前最前台的应用，因此行驶时手机屏幕会保持暂停，除非显示的是导航应用。MyPlay 不会读取其他任何内容。</string>
    <string name="mirror_locked_placeholder">手机锁屏时屏幕镜像会暂停。解锁手机即可显示。</string>
    <string name="mirror_driving_no_accessibility">行驶中手机屏幕会暂停。若要在行驶中显示导航应用，请在手机的无障碍设置中开启 MyPlay：它会告诉 MyPlay 当前打开的是哪个应用。</string>
    <string name="mirror_driving_nav_only">行驶中手机屏幕会暂停，仅显示导航应用。</string>
    <string name="mirror_need_screen_capture">手机屏幕需要 Android 的屏幕录制权限。请在手机上打开 MyPlay 的车载音频设置，点按“屏幕录制权限”，然后选择“整个屏幕”。</string>
    <string name="mirror_capture_failed">Android 拒绝共享手机屏幕。请在手机上的 MyPlay 车载音频设置中再次点按“屏幕录制权限”，然后选择“整个屏幕”。</string>
    <string name="mirror_need_accessibility">要在车机上操作手机，请在手机的无障碍设置中开启 MyPlay。</string>

