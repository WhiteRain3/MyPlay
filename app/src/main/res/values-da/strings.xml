<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">MyPlay</string>
    <string name="mirror_touch_description">Giver dig mulighed for at bruge telefonskærmen fra bilen: MyPlay gentager de tryk, der udføres på bilskærmen, på telefonen og kontrollerer, hvilken app der er forrest, så telefonskærmen forbliver sat på pause under kørsel, med mindre den viser en navigations-app. MyPlay læser ikke noget andet.</string>
    <string name="mirror_locked_placeholder">Telefonskærmen er sat på pause, mens telefonen er låst. Lås telefonen op for at vise den.</string>
    <string name="mirror_driving_no_accessibility">Telefonskærmen er sat på pause under kørsel. For at vise navigations-apps under kørsel skal du aktivere MyPlay i telefonens tilgængelighedsindstillinger: det fortæller MyPlay, hvilken app der er åben.</string>
    <string name="mirror_driving_nav_only">Telefonskærmen er sat på pause under kørsel. Den viser kun navigations-apps.</string>
    <string name="mirror_need_screen_capture">Telefonskærmen kræver Androids tilladelse til skærmoptagelse. Åbn MyPlays indstillinger for Bilaudio på telefonen, tryk på Tilladelse til skærmoptagelse, og vælg Hele skærmen.</string>
    <string name="mirror_capture_failed">Android afviste at dele telefonskærmen. Tryk igen på Tilladelse til skærmoptagelse i MyPlays indstillinger for Bilaudio på telefonen, og vælg Hele skærmen.</string>
    <string name="mirror_need_accessibility">For at bruge telefonen fra bilen skal du aktivere MyPlay i telefonens tilgængelighedsindstillinger.</string>

