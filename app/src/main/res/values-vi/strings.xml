<resources>
    <string name="app_name">MyPlay</string>
    <string name="mirror_touch_description">Cho phép bạn dùng màn hình điện thoại từ xe: MyPlay lặp lại các lần chạm trên màn hình xe sang điện thoại, và kiểm tra ứng dụng nào đang hiển thị để màn hình điện thoại tạm dừng khi lái xe, trừ khi đó là ứng dụng điều hướng. MyPlay không đọc gì khác.</string>
    <string name="mirror_locked_placeholder">Màn hình điện thoại tạm dừng khi điện thoại đang khóa. Mở khóa điện thoại để hiển thị.</string>
    <string name="mirror_driving_no_accessibility">Màn hình điện thoại tạm dừng khi đang lái xe. Để hiển thị ứng dụng điều hướng khi lái xe, hãy bật MyPlay trong cài đặt trợ năng của điện thoại: điều này giúp MyPlay biết ứng dụng nào đang mở.</string>
    <string name="mirror_driving_nav_only">Màn hình điện thoại tạm dừng khi đang lái xe. Nó chỉ hiển thị ứng dụng điều hướng.</string>
    <string name="mirror_need_screen_capture">Màn hình điện thoại cần quyền ghi màn hình của Android. Trên điện thoại, mở cài đặt Âm thanh xe hơi của MyPlay, nhấn Quyền ghi màn hình và chọn Toàn bộ màn hình.</string>
    <string name="mirror_capture_failed">Android đã từ chối chia sẻ màn hình điện thoại. Trên điện thoại, nhấn lại Quyền ghi màn hình trong cài đặt Âm thanh xe hơi của MyPlay và chọn Toàn bộ màn hình.</string>
    <string name="mirror_need_accessibility">Để dùng điện thoại từ xe, hãy bật MyPlay trong cài đặt trợ năng của điện thoại.</string>

