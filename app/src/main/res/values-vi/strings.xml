    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Máy chủ đầu đĩa</string>
    <string name="huserver_toggle_subtitle">Giống chế độ nhà phát triển của Android Auto, dùng cho đầu đĩa desktop, DHU, openauto, Headunit Revived. Chỉ truy cập được qua adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_subtitle">Cũng lắng nghe trên cổng TCP 5277 trên mọi mạng, không cần mật khẩu. Bất kỳ ai dùng chung Wi-Fi đều có thể kết nối, xem màn hình xe và dùng micro.</string>
    <string name="huserver_toggle_lanonce_subtitle">An toàn hơn: mạng phải được cho phép lại ở mỗi phiên. Hãy tắt tùy chọn này cho các đầu đĩa tự kết nối lại, như openauto hoặc Headunit Revived.</string>
    <string name="huserver_toggle_mirror_subtitle">Cũng cung cấp "Màn hình điện thoại" cho bất kỳ ai kết nối vào đây. Rủi ro: họ có thể thấy màn hình điện thoại và chạm vào nó, vì vậy hãy để tắt trừ khi bạn tin tưởng đầu đĩa này.</string>
    <string name="huserver_toggle_localhost_subtitle">Chấp nhận kết nối từ một ứng dụng kiểu Android Auto trong trình duyệt trên điện thoại này, dùng cho xe không có Android Auto (ví dụ: Tesla). Bất kỳ ứng dụng nào trên điện thoại cũng có thể kết nối, vì vậy hãy để tắt trừ khi bạn dùng một ứng dụng như vậy.</string>

